{
  "name": "daily-fit-checkin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "pnpm run typecheck && vite build --configLoader runner",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck --types node netlify/functions/api.mts",
    "preview": "vite preview --configLoader runner"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.9",
    "@netlify/functions": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "netlify-cli": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
